---
import SiteLayout from '../layouts/SiteLayout.astro';
import { contact } from '../data/practice';
---
<SiteLayout title="Dr. Devendra Kumar Shrimal" description="This page could not be found. Return to the doctor's website or call the clinic.">
  <section class="page-intro"><div class="container error-layout"><div class="error-copy"><p class="error-code">404</p><h1>We couldn't find this page.</h1><p>The link may have changed or the address may have been mistyped. You can return to the homepage or call the clinic for consultation information.</p><div class="error-actions"><a class="button" href="/">Return home</a><a class="text-link" href={contact.primaryHref}>Call {contact.primaryLabel}</a></div></div><div class="error-art" aria-hidden="true"><img src="/images/heart-detail-640.webp" width="640" height="631" alt="" decoding="async" /></div></div></section>
</SiteLayout>
