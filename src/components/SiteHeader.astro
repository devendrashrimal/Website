---
import { practice, contact } from '../data/practice';
const doctorName = practice.preferredName.value!;
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const navItems = [
 { href: '/', label: 'Home' },
 { href: '/doctor/', label: 'The doctor' },
 { href: '/heart-care/', label: 'Heart care' },
 { href: '/visit/', label: 'Plan your visit' },
];
---


  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label={`${doctorName} - home`}>
        <img class="brand-heart" src="/images/heart-logo.webp" width="56" height="56" alt="" /><span class="brand-text">{doctorName}<span>Cardiologist in Jaipur</span></span>
      </a>
      <div class="header-controls"><button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" hidden><span class="menu-label">Menu</span><span class="menu-lines" aria-hidden="true"></span></button></div>
      <nav id="main-navigation" class="main-navigation" aria-label="Main navigation">
        {navItems.map(item => <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
        <a class="header-call" href={contact.primaryHref}><span>Call clinic</span></a>
      </nav>
    </div>
  </header>


<script>
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const navigation = document.querySelector<HTMLElement>('#main-navigation');
    if (menuButton && navigation) {
      const mobile = window.matchMedia('(max-width: 1050px)');
      const setMenu = (open: boolean) => {
        menuButton.setAttribute('aria-expanded', String(open));
        navigation.classList.toggle('is-open', open);
      };
      menuButton.hidden = false;
      document.documentElement.classList.add('navigation-ready');
      menuButton.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
      navigation.addEventListener('click', event => {
        if ((event.target as HTMLElement).closest('a')) setMenu(false);
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          menuButton.focus();
        }
      });
      document.addEventListener('click', event => {
        if (!(event.target as HTMLElement).closest('.header-inner')) setMenu(false);
      });
      const controls = document.querySelector<HTMLElement>('.header-controls');
      const arrangeControls = () => {
        if (controls) {
          if (mobile.matches) navigation.before(controls);
          else navigation.after(controls);
        }
        setMenu(false);
      };
      arrangeControls();
      mobile.addEventListener('change', arrangeControls);
    }
</script>
