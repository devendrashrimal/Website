---
import SiteLayout from '../layouts/SiteLayout.astro';
import DoctorPortrait from '../components/DoctorPortrait.astro';
import { practice, contact, careAreas } from '../data/practice';
const doctorName = practice.preferredName.value!;
const consultation = practice.consultation;
---
<SiteLayout title={doctorName} description={`${doctorName}, ${practice.designation.value} at ${practice.currentAffiliation.value}. Explore heart care and plan your residence clinic consultation.`}>
  <section class="hero" aria-labelledby="hero-title"><div class="container hero-inner">
    <div class="hero-copy"><h1 id="hero-title">{doctorName}</h1><p class="hero-role">{practice.designation.value}<br />{practice.currentAffiliation.value}</p><p class="hero-intro">A conversation about your heart health, concerns and next steps.</p><div class="hero-actions"><a class="button" href={contact.primaryHref}>Call clinic</a><a class="text-link" href="/doctor/">Meet the doctor</a></div><p class="call-first">Please call before visiting. On-call duties may affect availability.</p></div>
    <DoctorPortrait />
  </div></section>
  <section class="visit-overview" aria-label="Consultation essentials"><div class="container overview-inner"><div class="overview-item"><p>Residence clinic</p><a href="/visit/">{consultation.addressLines[0]}<span>{consultation.addressLines[1]}</span></a></div><div class="overview-item"><p>Morning consultations</p><p class="overview-hours">{consultation.hoursSummary[0].hours}<span>{consultation.hoursSummary[0].days}</span></p></div><a class="text-link" href="/visit/">Hours and directions</a></div></section>
  <section class="home-doctor section-space container" aria-labelledby="home-doctor-title"><div data-reveal><h2 id="home-doctor-title">Your doctor, before your visit.</h2></div><div class="section-copy" data-reveal="sequence"><p>{doctorName} is {practice.hospital.role} at {practice.hospital.name}.</p><ul class="qualifications" aria-label="Qualifications">{practice.qualifications.value!.map(qualification => <li>{qualification}</li>)}</ul><a class="text-link" href="/doctor/">About the doctor</a></div></section>
  <section class="home-care section-space" aria-labelledby="home-care-title"><div class="container home-care-inner"><div data-reveal><h2 id="home-care-title">Areas of heart care</h2><p>Explore the areas of cardiology you can discuss during your consultation.</p><a class="text-link" href="/heart-care/">Heart care information</a></div><ul class="home-care-list" data-reveal="sequence">{careAreas.map(area => <li><a href="/heart-care/">{area.title}</a></li>)}</ul></div></section>
  <section class="home-visit section-space container" aria-labelledby="home-visit-title"><div data-reveal><h2 id="home-visit-title">Plan a residence clinic visit.</h2><p>{practice.booking.advisory}</p></div><div class="home-visit-details" data-reveal="sequence"><address>{consultation.addressLines.map(line => <span>{line}</span>)}</address><a class="phone-link" href={contact.primaryHref}>{contact.primaryLabel}</a><div class="home-visit-links"><a class="text-link" href="/visit/">Consultation details</a><a class="text-link" href={consultation.mapsUrl} target="_blank" rel="noopener noreferrer">Get directions<span class="sr-only"> (opens in a new tab)</span></a></div></div></section>
</SiteLayout>
