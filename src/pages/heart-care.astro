---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import { practice, careAreas } from '../data/practice';
---
<SiteLayout title={practice.preferredName.value!} description="Explore cardiology consultations, coronary and interventional care, heart rhythm and device care, and heart failure care.">
 <section class="page-intro"><div class="container" data-reveal><a class="breadcrumb" href="/">Home</a><h1>Heart care</h1><p>Explore the areas of cardiology you can discuss during your consultation.</p></div></section>
 <section class="care-catalog section-space container" aria-label="Areas of heart care">
  {careAreas.map(area => <article class="care-item" data-reveal><div><h2>{area.title}</h2><p>{area.description}</p></div></article>)}
 </section>
 <section class="patient-guide section-space"><div class="container guide-heading" data-reveal><h2>Start with your questions.</h2><div class="section-copy"><p>A consultation is a chance to discuss your concerns, existing reports and follow-up questions with the doctor.</p><p class="patient-note">The areas above describe topics for discussion. Tests, procedures and treatment are considered individually; this website does not confirm that a procedure is offered at the residence clinic.</p><a class="text-link" href="/visit/">Prepare for your consultation</a></div></div></section>
 <ConsultationCTA />
</SiteLayout>
