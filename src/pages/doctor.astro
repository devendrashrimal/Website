---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import { practice } from '../data/practice';
const doctorName = practice.preferredName.value!;
const qualifications = practice.qualifications.value!;
---
<SiteLayout title={doctorName} description={`Meet ${doctorName}, ${practice.designation.value} at ${practice.currentAffiliation.value}. Qualifications and clinical background.`}>
 <section class="page-intro"><div class="container" data-reveal><a class="breadcrumb" href="/">Home</a><h1>Meet your cardiologist.</h1><p>Professional background, qualifications and clinical practice.</p></div></section>
    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="container about-inner">
        <div class="about-intro" data-reveal>
          <figure class="clinical-photo">
            <picture>
              <source type="image/avif" srcset="/images/clinical-clear-480.avif 480w, /images/clinical-clear-768.avif 768w, /images/clinical-clear-979.avif 979w" sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1050px) calc(100vw - 48px), (max-width: 1280px) 52vw, 608px" />
              <source type="image/webp" srcset="/images/clinical-clear-480.webp 480w, /images/clinical-clear-768.webp 768w, /images/clinical-clear-979.webp 979w" sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1050px) calc(100vw - 48px), (max-width: 1280px) 52vw, 608px" />
              <img src="/images/clinical-clear-979.jpg" width="979" height="652" loading="lazy" decoding="async" alt="Dr. Devendra Kumar Shrimal working with his clinical team in an operating room" />
            </picture>
            <figcaption>Dr. Shrimal in clinical practice</figcaption>
          </figure>
        </div>
        <div class="about-copy" data-reveal="sequence"><h2 id="about-title">{doctorName}</h2><p>{doctorName} is {practice.hospital.role} at {practice.hospital.name}.</p><ul class="qualifications" aria-label="Qualifications">{qualifications.map(qualification => <li>{qualification}</li>)}</ul><a class="text-link text-link-light" href={practice.hospital.profileUrl} target="_blank" rel="noopener noreferrer">View the hospital profile<span class="sr-only"> (opens in a new tab)</span></a><p class="hospital-note">For residence clinic hours and contact details, <a class="inline-link" href="/visit/">plan your visit</a>. Please contact {practice.hospital.name} separately for hospital appointments.</p></div>
      </div>
    </section>


 <section class="qualification-section section-space" aria-labelledby="qualifications-title"><div class="container qualification-grid"><div data-reveal><h2 id="qualifications-title">Medical training</h2><p class="patient-note">The qualifications listed here provide a brief introduction to Dr. Shrimal’s professional background. His hospital profile offers further information.</p></div><dl class="qualification-list" data-reveal="sequence"><div><dt>MBBS</dt><dd>Bachelor of Medicine and Bachelor of Surgery</dd></div><div><dt>MD (General Medicine)</dt><dd>Postgraduate training in general medicine</dd></div><div><dt>DM (Cardiology)</dt><dd>Specialist training in cardiology</dd></div></dl></div></section>
 <div class="container section-space" data-reveal><div class="guide-heading"><h2>Two settings.<br />One clear place to start.</h2><div class="section-copy"><p>Residence clinic consultations and hospital appointments have separate arrangements. Choose the right location before planning your journey.</p><p class="patient-note">This website lists the residence clinic’s contact details and hours. For appointments at {practice.hospital.name}, please contact the hospital directly.</p><a class="text-link" href="/visit/">View residence clinic details</a></div></div></div>
 <ConsultationCTA />
</SiteLayout>
